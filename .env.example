# fake | openai | anthropic
CLAIMS_LLM_PROVIDER=fake

# Required only when CLAIMS_LLM_PROVIDER=openai
CLAIMS_OPENAI_API_KEY=
CLAIMS_OPENAI_MODEL=gpt-4o-mini

# Required only when CLAIMS_LLM_PROVIDER=anthropic
CLAIMS_ANTHROPIC_API_KEY=
CLAIMS_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Escalation
CLAIMS_FRAUD_HITL_THRESHOLD=0.65
CLAIMS_VALUE_HITL_THRESHOLD=25000
CLAIMS_CONFIDENCE_ESCALATION_THRESHOLD=0.55

# memory | postgres
CLAIMS_CHECKPOINTER=memory
CLAIMS_DATABASE_URL=

CLAIMS_LOG_LEVEL=INFO
CLAIMS_OTEL_ENABLED=false
CLAIMS_API_URL=http://localhost:8000
